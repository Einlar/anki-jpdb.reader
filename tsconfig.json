{
  "compilerOptions": {
    "outDir": "./anki-jpdb.reader/",
    "noImplicitAny": true,
    "module": "es6",
    "target": "es2021",
    "allowJs": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "removeComments": true,
    "strictNullChecks": true,
    "rootDir": ".",
    "types": ["chrome", "node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@styles/*": ["./src/styles/*"]
    }
  },
  "include": ["src/**/*", "changelog/**/*"]
}
